# The public address of the Al Rauf backend API (no trailing slash).
# This is read by the visitor's browser, so it must be a public address in production.
# NOTE: NEXT_PUBLIC_* values are baked in when you run `npm run build`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional. Used by the Next.js server only (menu, settings, gallery and jobs are fetched on the server).
# Set this when the server can reach the API on a private address, e.g. http://backend:4000 inside Docker.
# Leave empty to use NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_URL=

# The public address of this website (no trailing slash). Used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
